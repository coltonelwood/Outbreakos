# OutbreakOS Environment Variables
# Copy to .env.local and fill in values. The product runs in full demo mode
# without any of these set.

# Demo mode: when "true", auth and data are seeded in-memory (no Supabase needed)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (optional - leave empty to keep demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (optional - app falls back to deterministic templates)
# Supported: openai | anthropic | none
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Messaging provider (optional - templates available offline)
# Supported: twilio | whatsapp | none
MESSAGING_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe (optional - pricing page works without it)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Map tiles (Leaflet uses OpenStreetMap by default; Mapbox optional)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Demo seed - the bundled outbreak scenario
NEXT_PUBLIC_DEMO_SCENARIO=drc-uganda-bundibugyo-2026
