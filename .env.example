# OutbreakOS environment variables.
# Copy to .env.local and edit. The product runs in full demo mode without
# any of these set — but several MUST be set for production deployment.

# -----------------------------------------------------------
# REQUIRED IN PRODUCTION
# -----------------------------------------------------------

# Signed-session HMAC secret. Generate with: openssl rand -base64 48
# In production the app refuses to start without a real value.
SESSION_SECRET=

# When "true", the app refuses to serve unless a durable datastore (Supabase)
# is configured — locks out the in-memory store in production. Leave unset
# until the data-layer swap (supabase/SWAP.md) is complete.
REQUIRE_PERSISTENCE=

# Public base URL — used to build invite / set-password links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------
# Demo mode (default: true). When true, in-memory store and seeded
# Bundibugyo scenario are active. Flip to false in production.
# -----------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=true

# -----------------------------------------------------------
# Supabase (optional — leave empty to keep in-memory demo store)
# Run supabase/schema.sql + supabase/seed.sql in your Supabase project
# before pointing at it.
# -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------
# AI provider (optional — falls back to deterministic templates that
# READ live org data, so output is real even without an API key)
# Supported: openai | anthropic | none
# -----------------------------------------------------------
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------
# Messaging provider (optional — templates available offline)
# Supported: twilio | whatsapp | none
# -----------------------------------------------------------
MESSAGING_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------
# Lead capture — Slack webhook for new demo / pilot requests.
# Set this so /contact form notifications reach you in real time.
# Create one at https://api.slack.com/messaging/webhooks
# -----------------------------------------------------------
LEADS_WEBHOOK_URL=

# Operational alert notifications (urgent screenings, critical alerts).
# Falls back to LEADS_WEBHOOK_URL if unset.
ALERTS_WEBHOOK_URL=

# Email provider for invites + alert emails (Resend). Without it, invite
# links are surfaced in-app to the admin instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=alerts@outbreakos.io

# -----------------------------------------------------------
# Upstash Redis (optional — replaces in-process rate limiter)
# Set both vars to enable cross-instance rate limiting.
# https://upstash.com/docs/redis/sdks/ts/getstarted
# -----------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------
# Stripe (optional)
# -----------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------
# Map tiles (Leaflet uses OpenStreetMap by default; Mapbox optional)
# -----------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------
# Demo seed name
# -----------------------------------------------------------
NEXT_PUBLIC_DEMO_SCENARIO=drc-uganda-bundibugyo-2026
